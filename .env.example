# The app an agent is sent to when it needs a credential. Every credential the pack holds was
# approved or confirmed by a human on one of two screens there.
TIMELINE_APP_URL=http://localhost:4002

# The backend the pack reads and writes through.
TIMELINE_API_URL=http://localhost:8080

# Credentials are deliberately NOT configurable here. The external tool token and every project key
# live in .credentials/, written by timeline.authenticate after a human approved or confirmed them in
# the app - an environment variable is exactly how that step would get bypassed, so the pack defines
# none that accepts a credential.
